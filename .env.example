MARKET=ETH
MARKET_DATA_MODE=DEMO
EXECUTION_MODE=PAPER

MARKET_STALE_AFTER_SECONDS=5
DEMO_UPDATE_INTERVAL_SECONDS=1

ENABLE_HYPERLIQUID_TESTNET_ORDERS=false
HYPERLIQUID_PRIVATE_KEY=
HYPERLIQUID_ACCOUNT_ADDRESS=
HYPERLIQUID_TESTNET_URL=https://api.hyperliquid-testnet.xyz

CORS_ORIGINS=http://localhost:5173

REFERENCE_FIREWALL_ENABLED=true

# Phase 8 external reference providers. Credentials stay backend-only.
REDSTONE_ENABLED=true
REDSTONE_API_KEY=
REDSTONE_DATA_SERVICE_ID=redstone-primary-prod
REDSTONE_FEED_ID=ETH
# Set to the current official RedStone Live WebSocket URL for your account/docs.
REDSTONE_LIVE_WS_URL=
REDSTONE_STALE_AFTER_SECONDS=5
# One RedStone provider: authenticated Live primary, no-key public cache fallback.
# Explicit startup-market mapping; never infer a symbol for a different market.
REDSTONE_PUBLIC_HTTP_FALLBACK_ENABLED=true
REDSTONE_PUBLIC_HTTP_URL=https://api.redstone.finance/prices
REDSTONE_PUBLIC_HTTP_PROVIDER=redstone
REDSTONE_PUBLIC_HTTP_SYMBOL=ETH
REDSTONE_PUBLIC_HTTP_POLL_INTERVAL_SECONDS=10
REDSTONE_PUBLIC_HTTP_STALE_AFTER_SECONDS=30

KRAKEN_REFERENCE_ENABLED=false
KRAKEN_SYMBOL=
KRAKEN_WS_URL=wss://ws.kraken.com/v2
KRAKEN_STALE_AFTER_SECONDS=5

COINGECKO_REFERENCE_ENABLED=false
COINGECKO_API_KEY=
COINGECKO_COIN_ID=
COINGECKO_API_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_POLL_INTERVAL_SECONDS=20
COINGECKO_STALE_AFTER_SECONDS=90
